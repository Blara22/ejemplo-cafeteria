# Peticiones de prueba para la API de la cafetería (Clase 3)
# Requiere la extensión "REST Client" de VS Code (humao.rest-client).
# Servidor: desde la raíz del proyecto ->  php -S localhost:8000
# Haz clic en "Send Request" sobre cada petición.

@host = http://localhost:81/ejemplo-cafeteria

###############################################################
# PRODUCTOS: LEER (SELECT)
###############################################################

### Listar todos
GET {{host}}/api/productos.php

### Obtener uno por id
GET {{host}}/api/productos.php?id=1

### Buscar por nombre
GET {{host}}/api/productos.php?buscar=caf

### Id que no existe (espera 404)
GET {{host}}/api/productos.php?id=999

###############################################################
# PRODUCTOS: CREAR (INSERT)
###############################################################

### Crear producto (espera 201)
POST {{host}}/api/productos.php
Content-Type: application/json

{
  "nombre": "Moka",
  "precio": 55,
  "emoji": "☕"
}

### Crear con datos inválidos (espera 422)
POST {{host}}/api/productos.php
Content-Type: application/json

{
  "nombre": "A",
  "precio": -5
}

###############################################################
# PRODUCTOS: ACTUALIZAR (UPDATE)
# Cambia el id por el que te devolvió el POST
###############################################################

### Actualizar (espera 200)
PUT {{host}}/api/productos.php?id=7
Content-Type: application/json

{
  "nombre": "Moka con canela",
  "precio": 58,
  "emoji": "☕"
}

### Actualizar un id que no existe (espera 404)
PUT {{host}}/api/productos.php?id=999
Content-Type: application/json

{
  "nombre": "Fantasma",
  "precio": 10,
  "emoji": "👻"
}

###############################################################
# PRODUCTOS: ELIMINAR (DELETE)
###############################################################

### Eliminar el producto creado (espera 204)
DELETE {{host}}/api/productos.php?id=7

### Eliminar uno que no existe (espera 404)
DELETE {{host}}/api/productos.php?id=999

### Eliminar un producto que ya está en un pedido (espera 409)
# Primero crea un pedido con el producto 1 y luego ejecuta esta petición
DELETE {{host}}/api/productos.php?id=1

###############################################################
# PEDIDOS (INSERT con transacción)
###############################################################

### Crear pedido (espera 201; el total lo calcula el servidor)
POST {{host}}/api/pedidos.php
Content-Type: application/json

{
  "nombre": "Ana López",
  "email": "ana@mail.com",
  "items": [
    { "id": 1, "cantidad": 2 },
    { "id": 3, "cantidad": 1 }
  ]
}

### Pedido con producto inexistente (espera 422 y que NO se guarde nada)
POST {{host}}/api/pedidos.php
Content-Type: application/json

{
  "nombre": "Ana López",
  "email": "ana@mail.com",
  "items": [
    { "id": 1, "cantidad": 1 },
    { "id": 999, "cantidad": 1 }
  ]
}

### Pedido con datos inválidos (espera 422)
POST {{host}}/api/pedidos.php
Content-Type: application/json

{
  "nombre": "An",
  "email": "no-es-correo",
  "items": []
}

### Método no permitido (espera 405)
GET {{host}}/api/pedidos.php

###############################################################
# DEMO DE INYECCIÓN SQL (solo con api/inseguro.php temporal)
###############################################################

### Versión vulnerable: devuelve TODOS los productos
GET {{host}}/api/inseguro.php?id=0%20OR%201=1

### Versión segura (productos.php): espera 404
GET {{host}}/api/productos.php?id=0%20OR%201=1
